# Local Postgres, read by infra/compose. Obvious local values only.
POSTGRES_USER=spaceship
POSTGRES_PASSWORD=spaceship
POSTGRES_DB=spaceship

# The API reads this URL and no other connection setting.
DATABASE_URL=postgresql+psycopg://spaceship:spaceship@localhost:54329/spaceship

# At least 32 bytes. The placeholder below is rejected at startup.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=spaceship
JWT_AUDIENCE=spaceship-web

# Optional. The desk works without it. POST /v1/questions returns 503 until it is set.
ANTHROPIC_API_KEY=

# Optional. Chat tab titles use this key with gpt-5-nano. Without it, the tab keeps the first question.
OPENAI_API_KEY=

# Used by scripts/bootstrap/run.py load. Not read by the API process.
BOOTSTRAP_ADMIN_EMAIL=admin@spaceship.local
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Comma-separated browser origins for direct API calls.
CORS_ORIGINS=http://localhost:5173

# Set true behind HTTPS. Local HTTP must stay false or the refresh cookie is dropped.
COOKIE_SECURE=false
